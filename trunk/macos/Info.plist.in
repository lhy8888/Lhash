<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>LHash</string>
    <key>CFBundleIdentifier</key><string>org.lhash.desktop</string>
    <key>CFBundleName</key><string>LHash</string>
    <key>CFBundleDisplayName</key><string>LHash</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>@LHASH_APP_SHORT_VERSION@</string>
    <key>CFBundleVersion</key><string>@LHASH_APP_VERSION@</string>
    <key>CFBundleIconFile</key><string>LHash.icns</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>LSArchitecturePriority</key><array><string>arm64</string></array>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleLocalizations</key><array><string>en</string><string>zh-Hans</string></array>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSSupportsAutomaticTermination</key><false/>
    <key>NSSupportsSuddenTermination</key><false/>
    <key>NSHumanReadableCopyright</key><string>GPL-2.0-only with OpenSSL linking exception</string>
</dict>
</plist>
