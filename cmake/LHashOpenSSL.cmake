# Require an explicitly selected, pinned static installation. FindOpenSSL's
# OPENSSL_ROOT_DIR is only a hint, so verify the resolved paths as well.
function(lhash_link_openssl target_name)
    if (NOT OPENSSL_ROOT_DIR)
        message(FATAL_ERROR "Set OPENSSL_ROOT_DIR to the vendored OpenSSL 3.5.9 installation.")
    endif()
    set(OPENSSL_USE_STATIC_LIBS TRUE)
    if (MSVC)
        set(OPENSSL_MSVC_STATIC_RT TRUE)
    endif()
    find_package(OpenSSL 3.5.9 EXACT REQUIRED COMPONENTS Crypto)
    file(REAL_PATH "${OPENSSL_ROOT_DIR}" requested_root)
    foreach (found_path IN LISTS OPENSSL_INCLUDE_DIR OPENSSL_CRYPTO_LIBRARY)
        if (found_path MATCHES "^(optimized|debug|general)$")
            continue()
        endif()
        file(REAL_PATH "${found_path}" resolved_path)
        cmake_path(IS_PREFIX requested_root "${resolved_path}" NORMALIZE is_vendor_path)
        if (NOT is_vendor_path)
            message(FATAL_ERROR "OpenSSL path '${resolved_path}' is outside '${requested_root}'.")
        endif()
    endforeach()
    target_compile_definitions(${target_name} PUBLIC LHASH_WITH_OPENSSL3_VENDOR=1)
    # Registry headers are inline and feature-dependent: consumers must compile
    # with the same definitions and headers as the library.
    set_property(TARGET ${target_name} PROPERTY NO_SYSTEM_FROM_IMPORTED TRUE)
    target_include_directories(${target_name} BEFORE PUBLIC "${OPENSSL_INCLUDE_DIR}")
    target_link_libraries(${target_name} PUBLIC OpenSSL::Crypto ${CMAKE_DL_LIBS})
    if (WIN32)
        target_link_libraries(${target_name} PUBLIC ws2_32 gdi32 advapi32 crypt32 user32)
    endif()
    message(STATUS "LHash static OpenSSL: ${OPENSSL_CRYPTO_LIBRARY}")
endfunction()
